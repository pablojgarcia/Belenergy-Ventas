# ⚠️ Copiar este archivo a .env y completar los valores.
#    NUNCA committear el .env al repositorio.
#    En Railway/usar el panel de Environment Secrets (cifrados en reposo y transito).

# ─── Variables de aplicación ────────────────────────────────────────────────
# OBLIGATORIA para el backend local (fuera de Docker) y para Railway.
# En docker compose se ignora: la inyecta el propio compose apuntando al
# servicio `db` (ver seccion Compose abajo).
DATABASE_URL=postgresql://appuser:apppassword@localhost:5432/authdb

# Clave JWT. En compose se usa este valor por defecto si no esta definida.
# NO usar la de ejemplo en produccion: genera una con openssl rand -hex 32.
JWT_SECRET=genera-uno-con-openssl-rand-hex-32

CORS_ORIGINS=http://localhost:8000,https://tudominio.com
ODOO_URL=https://belenergy-ventas.odoo.com
ODOO_DB=belenergy-ventas
ODOO_USER=your-odoo-user@example.com
ODOO_PASSWORD=your-odoo-password
# Opcional: id de `stock.warehouse` de Odoo. Si se setea, el stock sincronizado
# (virtual_available) se calcula para ese almacén; si no, se usa el default de
# la compañía. ⚠️ Forzar un almacén cambia el stock resultante.
ODOO_WAREHOUSE_ID=

# ─── Credenciales de Postgres (usadas por el servicio `db` de compose) ─────
# Si le cambiás esto, el backend en el contenedor se conecta automaticamente
# porque compose arma la DATABASE_URL interna con esos valores.
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppassword
POSTGRES_DB=authdb

# ─── Puertos de host (opcional, solo para compose) ─────────────────────────
# Puerto expuesto del backend+frontend (http://localhost:8000).
API_PORT=8000
# Puerto expuesto de Postgres en el host. Cambialo a 5433 si ya tenes un
# Postgres local corriendo en 5432.
DB_PORT=5432